{
	"name": "@roadwise/web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun test",
		"db:generate": "drizzle-kit generate",
		"db:generate:custom": "drizzle-kit generate --custom",
		"db:migrate:local": "bun run scripts/migrate.ts local",
		"db:migrate:staging": "bun run scripts/migrate.ts staging",
		"db:migrate:prod": "bun run scripts/migrate.ts production",
		"db:studio:local": "DRIZZLE_ENV_FILE=.env.db.local drizzle-kit studio",
		"db:studio:staging": "DRIZZLE_ENV_FILE=.env.db.staging drizzle-kit studio",
		"db:studio:prod": "DRIZZLE_ENV_FILE=.env.db.production drizzle-kit studio",
		"db:env:local": "bun run scripts/write-db-env.ts local",
		"db:env:staging": "bun run scripts/write-db-env.ts staging",
		"db:env:prod": "bun run scripts/write-db-env.ts production",
		"db:env:all": "bun run scripts/write-db-env.ts all",
		"env:pull:local": "vercel env pull .env.local --environment=development --yes",
		"env:pull:staging": "vercel env pull .env.staging.local --environment=preview --yes",
		"env:pull:prod": "vercel env pull .env.production.local --environment=production --yes"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"@clerk/nextjs": "^6.31.6",
		"@hookform/resolvers": "^5.2.1",
		"@libsql/client": "^0.15.14",
		"@roadwise/contracts": "workspace:*",
		"@roadwise/sdk": "workspace:*",
		"@vercel/blob": "^2.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"dotenv": "^16.6.1",
		"drizzle-orm": "^0.44.5",
		"effect": "4.0.5",
		"lucide-react": "^1.16.0",
		"motion": "^12.23.12",
		"next": "^16.2.6",
		"next-themes": "^0.4.6",
		"posthog-js": "^1.261.0",
		"posthog-node": "^5.8.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-hook-form": "^7.62.0",
		"shadcn": "^4.8.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.1.5"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.12",
		"@types/node": "^22.18.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"drizzle-kit": "^0.31.4",
		"postcss": "^8.5.6",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.2"
	}
}
