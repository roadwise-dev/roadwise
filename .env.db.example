# Copy this file to one of:
# .env.db.local
# .env.db.preview
# .env.db.staging
# .env.db.production

# Local file DB example:
# TURSO_DATABASE_URL=file:local.db

# Turso remote DB example:
# TURSO_DATABASE_URL=libsql://roadwise-dev-org.turso.io
# TURSO_AUTH_TOKEN=your-token

TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=
