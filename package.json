{
	"name": "roadwise",
	"private": true,
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @roadwise/web dev",
		"build": "bun run --filter '*' build",
		"start": "bun run --filter @roadwise/web start",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "bun run --filter '*' test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16"
	}
}
